{
  "name": "ifluent-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/remove-nested-react.js",
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev  --filter=@ifluent/landing",
    "dev:crm": "turbo run dev  --filter=@ifluent/frontend-crm",
    "dev:student": "turbo run dev  --filter=@ifluent/frontend-student",
    "dev:teacher": "turbo run dev  --filter=@ifluent/frontend-teacher",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.5.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "dependencies": {
    "expo-dev-client": "~6.0.21"
  }
}
