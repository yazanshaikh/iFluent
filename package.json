{
  "name": "ifluent-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/remove-nested-react.js",
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev  --filter=@ifluent/landing",
    "dev:crm": "turbo run dev  --filter=@ifluent/frontend-crm",
    "dev:student": "turbo run dev  --filter=@ifluent/frontend-student",
    "dev:teacher": "turbo run dev  --filter=@ifluent/frontend-teacher",
    "desktop:student": "npm run start --workspace=@ifluent/frontend-student-desktop",
    "desktop:teacher": "npm run start --workspace=@ifluent/frontend-teacher-desktop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-worklets": "0.5.1",
    "react-native-reanimated": "~4.1.1"
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-worklets": "0.5.1",
    "react-native-reanimated": "~4.1.1"
  }
}
