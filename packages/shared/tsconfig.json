{
  "compilerOptions": {
    "target":          "ESNext",
    "module":          "ESNext",
    "moduleResolution":"bundler",
    "jsx":             "react-native",
    "strict":          true,
    "skipLibCheck":    true,
    "declaration":     true,
    "declarationMap":  true,
    "sourceMap":       true,
    "outDir":          "./dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
