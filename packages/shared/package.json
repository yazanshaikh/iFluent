{
  "name": "@ifluent/shared",
  "version": "0.1.0",
  "description": "Shared constants, hooks, and types for iFluent apps",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./hooks":     "./src/hooks/index.ts",
    "./types":     "./src/types/index.ts"
  },
  "scripts": {
    "lint":       "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react":        ">=19.0.0",
    "react-native": ">=0.81.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript":   "~5.9.2"
  }
}
