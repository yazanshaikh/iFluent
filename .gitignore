# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
web-build/
**/dist/
**/build/
**/web-build/

# ── Expo ──────────────────────────────────────────────────────────────────────
**/.expo/
**/expo-env.d.ts

# ── Laravel ───────────────────────────────────────────────────────────────────
backend/vendor/
backend/.env
backend/storage/logs/*.log

# ── Environment files ─────────────────────────────────────────────────────────
# الـ .env لكل تطبيق لا يُرفع على git — استخدم .env.example بدله
.env
**/.env
!**/.env.example
!.env.example

# ── Turbo cache ───────────────────────────────────────────────────────────────
.turbo/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.idea/
*.log

# Local production env files for desktop/EAS builds (contain secrets)
apps/*/.env.production
