# ─────────────────────────────────────────────────────────────────────────────
#  docker-compose.prod.yml — HOST-level env (compose interpolation ONLY).
#  Copy to .env.prod and fill in real values:  cp .env.prod.example .env.prod
#  These feed the postgres service + its healthcheck.
# ─────────────────────────────────────────────────────────────────────────────
DB_DATABASE=ifluent
DB_USERNAME=ifluent_user
DB_PASSWORD=CHANGE_ME_to_a_long_random_password

# ─────────────────────────────────────────────────────────────────────────────
#  IMPORTANT: the Laravel app reads its OWN config from backend/.env (NOT this
#  file). On the server, backend/.env must contain (production values):
#
#    APP_ENV=production
#    APP_DEBUG=false
#    APP_KEY=base64:...                 # php artisan key:generate
#    APP_URL=https://api.ifluent.app
#
#    DB_CONNECTION=pgsql
#    DB_HOST=db                         # ← internal docker service name (hidden)
#    DB_PORT=5432
#    DB_DATABASE=ifluent                # ← must match DB_DATABASE above
#    DB_USERNAME=ifluent_user           # ← must match DB_USERNAME above
#    DB_PASSWORD=...                    # ← must match DB_PASSWORD above
#
#    REDIS_HOST=redis
#    QUEUE_CONNECTION=redis
#    CACHE_STORE=redis
#    SESSION_DRIVER=redis
#    SESSION_DOMAIN=.ifluent.app
#    SANCTUM_STATEFUL_DOMAINS=crm.ifluent.app,ifluent.app
#
#    # Reverb (realtime) — public side goes through nginx on 443
#    REVERB_HOST=api.ifluent.app
#    REVERB_PORT=443
#    REVERB_SCHEME=https
#    REVERB_SERVER_HOST=0.0.0.0
#    REVERB_SERVER_PORT=8080
#
#  And config/cors.php → allowed_origins:
#    https://crm.ifluent.app, https://ifluent.app
# ─────────────────────────────────────────────────────────────────────────────
