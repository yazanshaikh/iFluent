# ── apps/frontend-crm — CRM Dashboard (React 19 + Vite + ShadCN) ─────────────
# وصول: موظفون فقط — Roles: crm_agent | super_admin
# المسارات المسموحة في Laravel (middleware: RequireRole):
#   POST /api/v1/crm/auth/login
#   GET  /api/v1/crm/leads
#   POST /api/v1/crm/leads
#   ...  (جميع مسارات /crm/* و /admin/*)

# محلي
VITE_API_URL=http://192.168.0.104:8000/api/v1
VITE_APP_URL=http://localhost:3100

# إنتاج — يُرفع على subdomain منفصل: crm.ifluent.io
# VITE_API_URL=https://api.ifluent.io/api/v1
# VITE_APP_URL=https://crm.ifluent.io

# معرّف المشروع (اختياري — للتحليلات)
# VITE_APP_NAME=iFluent CRM
