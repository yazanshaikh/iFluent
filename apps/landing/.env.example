# ── apps/landing — Landing Page (Expo Web) ───────────────────────────────────
# وصول: عام — Public API فقط (لا يوجد توكن)
# المسارات المسموحة في Laravel:
#   GET  /api/v1/settings          ← جلب إعدادات الموقع
#   POST /api/v1/public/booking    ← إرسال طلب حجز (Lead)

# محلي — استبدل بـ IP جهازك
EXPO_PUBLIC_API_URL=http://192.168.0.104:8000/api/v1

# إنتاج
# EXPO_PUBLIC_API_URL=https://api.ifluent.io/api/v1

# CRM subdomain — hidden admin entry (5 taps on copyright in Footer)
# محلي:
EXPO_PUBLIC_CRM_URL=http://localhost:8081
# إنتاج:
# EXPO_PUBLIC_CRM_URL=https://crm.ifluent.io
