# ══════════════════════════════════════════════════════════════════════
#  iFluent Monorepo — Root .env.example
#  هذا الملف نموذج — انسخه إلى .env في كل مجلد تطبيق واملأ القيم
# ══════════════════════════════════════════════════════════════════════

# ── Backend API (Laravel) ──────────────────────────────────────────────
# على الجهاز المحلي: استخدم IP الكمبيوتر بدل localhost
# حتى يعمل على الأجهزة المحمولة على نفس الشبكة
API_BASE_URL=http://192.168.0.104:8000/api/v1

# على الإنتاج:
# API_BASE_URL=https://api.ifluent.io/api/v1

# ── لتطبيقات Expo: prefix = EXPO_PUBLIC_ ──────────────────────────────
# EXPO_PUBLIC_API_URL=http://192.168.0.104:8000/api/v1

# ── لتطبيق CRM (Vite/React): prefix = VITE_ ──────────────────────────
# VITE_API_URL=http://192.168.0.104:8000/api/v1
